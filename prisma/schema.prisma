// GSX — Prisma Schema
// Architecture v1.3
// Stores: user accounts, orders, order items, company profiles, password reset tokens.
// Content (products, dispensaries, articles) is managed in Sanity.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Neon requires directUrl for migrations
  directUrl = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────────────────────

enum UserRole {
  BUYER
  ADMIN
}

enum AccountStatus {
  PENDING                  // New signup — awaiting admin approval
  PASSWORD_RESET_REQUIRED  // Migrated account — must set new password before login
  ACTIVE
  SUSPENDED
}

enum OrderStatus {
  SUBMITTED   // Buyer submitted — pending GSX acknowledgement
  PROCESSING  // GSX is fulfilling
  COMPLETED   // Fulfilled
  CANCELLED
}

// ─────────────────────────────────────────────────────────────
// User
// Dispensary buyers and GSX admin staff.
// ─────────────────────────────────────────────────────────────

model User {
  id            String        @id @default(cuid())
  email         String        @unique
  passwordHash  String?       // bcrypt (cost 12). Null until password reset confirmed.
  firstName     String
  lastName      String
  phone         String
  address       String
  city          String
  state         String
  zip           String
  ommaLicense   String        // Oklahoma Medical Marijuana Authority license number
  role          UserRole      @default(BUYER)
  accountStatus AccountStatus @default(PENDING)

  // Relations
  company       Company?
  orders        Order[]
  resetTokens   PasswordResetToken[]

  // Timestamps
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  // Migration reference — original accounts.id from MySQL
  legacyId      Int?          @unique
}

// ─────────────────────────────────────────────────────────────
// Company
// Dispensary company details, attached to a buyer account.
// Used in order confirmation emails and order records.
// ─────────────────────────────────────────────────────────────

model Company {
  id          String  @id @default(cuid())
  name        String
  address     String
  city        String
  state       String
  zip         String
  ommaLicense String
  email       String
  phone       String

  // Relations
  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String  @unique
}

// ─────────────────────────────────────────────────────────────
// PasswordResetToken
// Used for both post-migration forced resets and ongoing forgot-password flows.
// The raw token is emailed; only the SHA-256 hash is stored.
// ─────────────────────────────────────────────────────────────

model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique  // SHA-256 hash of the raw token sent in the email
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime? // Set when token is consumed — prevents reuse
  createdAt DateTime  @default(now())
}

// ─────────────────────────────────────────────────────────────
// Order
// A wholesale order submitted by a dispensary buyer.
// No payment data is stored — orders are fulfilled offline.
// ─────────────────────────────────────────────────────────────

model Order {
  id          String      @id @default(cuid())
  userId      String
  user        User        @relation(fields: [userId], references: [id])
  items       OrderItem[]
  status      OrderStatus @default(SUBMITTED)
  notes       String?     // Optional buyer notes

  // Snapshot of buyer's company info at time of order
  // (company record may be updated later)
  companyName    String?
  companyAddress String?
  companyCity    String?
  companyState   String?
  companyZip     String?
  companyOmma    String?
  companyEmail   String?
  companyPhone   String?

  submittedAt DateTime  @default(now())
  completedAt DateTime?
  updatedAt   DateTime  @updatedAt

  // Migration reference — original orders.id from MySQL
  legacyId    Int?      @unique
}

// ─────────────────────────────────────────────────────────────
// OrderItem
// A line item within an order. Product details are snapshotted
// at order time — Sanity product data may change later.
// ─────────────────────────────────────────────────────────────

model OrderItem {
  id               String   @id @default(cuid())
  orderId          String
  order            Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  // Product snapshot (from Sanity at time of order)
  sanityProductId  String   // Sanity document _id
  productTitle     String   // Captured at order time
  unitPrice        Decimal  @db.Decimal(10, 2)
  quantity         Int
  subtotal         Decimal  @db.Decimal(10, 2)

  // Migration reference — original image filename from MySQL
  legacyImageRef   String?
}

// ═════════════════════════════════════════════════════════════
// Portal: customer ordering and administrator approvals
//
// These tables are the Postgres equivalent of the approved HostGator
// portal (schema.sql, admin-setup.sql, ordering-setup.sql on the
// hostgator-static branch): same fields, same statuses, same two price
// lists. They are separate from the models above, which the earlier
// next-auth setup uses, so nothing above is changed or reused here.
// Row ids are integers because the portal screens, and the approved
// HostGator JSON responses they read, use integer ids.
// ═════════════════════════════════════════════════════════════

enum PortalAccountStatus {
  pending                  // New signup, awaiting admin approval
  active
  suspended
  password_reset_required  // Migrated account: must set a new password first
}

enum PortalPricingTier {
  old  // Old / Grandfathered
  new  // New / Standard
}

enum PortalOrderStatus {
  in_progress
  completed
}

enum PortalAdminStatus {
  active
  disabled
}

model PortalUser {
  id            Int                 @id @default(autoincrement())
  firstName     String              @map("first_name")
  lastName      String              @map("last_name")
  address       String
  city          String
  state         String              @db.VarChar(2)
  zip           String              @db.VarChar(10)
  ommaLicense   String              @map("omma_license")
  email         String              @unique
  phone         String              @db.VarChar(30)
  passwordHash  String?             @map("password_hash")
  accountStatus PortalAccountStatus @default(pending) @map("account_status")
  createdAt     DateTime            @default(now()) @map("created_at")
  updatedAt     DateTime            @updatedAt @map("updated_at")
  legacyId      Int?                @unique @map("legacy_id")

  companies   PortalCompany[]
  pricing     PortalCustomerPricing?
  cartItems   PortalCartItem[]
  orders      PortalOrder[]
  resetTokens PortalPasswordResetToken[]

  @@map("portal_users")
}

model PortalAdmin {
  id                 Int               @id @default(autoincrement())
  email              String            @unique
  firstName          String            @map("first_name")
  passwordHash       String            @map("password_hash")
  mustChangePassword Boolean           @default(true) @map("must_change_password")
  status             PortalAdminStatus @default(active)
  createdAt          DateTime          @default(now()) @map("created_at")
  updatedAt          DateTime          @updatedAt @map("updated_at")

  @@map("portal_admins")
}

model PortalAuditLog {
  id           BigInt   @id @default(autoincrement())
  adminId      Int      @map("admin_id")
  action       String   @db.VarChar(50)
  targetUserId Int?     @map("target_user_id")
  detail       String?  @db.VarChar(255)
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([adminId, createdAt])
  @@index([targetUserId])
  @@map("portal_admin_audit_log")
}

model PortalCompany {
  id          Int        @id @default(autoincrement())
  userId      Int        @map("user_id")
  user        PortalUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  address     String
  city        String
  state       String     @db.VarChar(2)
  zip         String     @db.VarChar(10)
  ommaLicense String     @map("omma_license")
  email       String
  phone       String     @db.VarChar(30)
  createdAt   DateTime   @default(now()) @map("created_at")
  legacyId    Int?       @unique @map("legacy_id")

  @@index([userId])
  @@map("portal_companies")
}

model PortalPasswordResetToken {
  id        Int        @id @default(autoincrement())
  userId    Int        @map("user_id")
  user      PortalUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String     @unique @map("token_hash") @db.VarChar(64) // SHA-256 hex of the emailed token
  expiresAt DateTime   @map("expires_at")
  usedAt    DateTime?  @map("used_at")
  createdAt DateTime   @default(now()) @map("created_at")

  @@index([userId])
  @@map("portal_password_reset_tokens")
}

model PortalLoginAttempt {
  id          BigInt   @id @default(autoincrement())
  email       String
  ipAddress   String   @map("ip_address") @db.VarChar(45)
  succeeded   Boolean  @default(false)
  attemptedAt DateTime @default(now()) @map("attempted_at")

  @@index([email, attemptedAt])
  @@index([ipAddress, attemptedAt])
  @@map("portal_login_attempts")
}

// Server-side sessions, the same model as the HostGator build's PHP sessions.
// The browser holds only a random id in an httpOnly cookie; only its SHA-256
// is stored, so a database leak cannot be replayed as a login.
model PortalSession {
  id            String    @id @db.VarChar(64)
  csrfToken     String    @map("csrf_token") @db.VarChar(64)
  userId        Int?      @map("user_id")
  adminId       Int?      @map("admin_id")
  adminLastSeen DateTime? @map("admin_last_seen")
  createdAt     DateTime  @default(now()) @map("created_at")
  expiresAt     DateTime  @map("expires_at")

  @@index([expiresAt])
  @@map("portal_sessions")
}

// `price` is the standard (current) price; `legacyPrice` is the grandfathered
// (original) price, null meaning "same as standard". Which one a customer is
// charged is that customer's PortalCustomerPricing row, chosen by an
// administrator, and read in one place: lib/portal/shop.ts.
model PortalProduct {
  id          Int      @id @default(autoincrement())
  legacyId    Int?     @unique @map("legacy_id")
  sku         String?  @db.VarChar(50)
  title       String
  description String
  image       String
  price       Decimal  @db.Decimal(10, 2)
  legacyPrice Decimal? @map("legacy_price") @db.Decimal(10, 2)
  inStock     Boolean  @default(true) @map("in_stock")
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  cartItems PortalCartItem[]

  @@map("portal_products")
}

// Which of the two price lists a customer is charged from. A customer with
// NO row here has no pricing assigned and cannot see prices or order until an
// administrator assigns one. Nothing is ever assigned automatically.
model PortalCustomerPricing {
  userId    Int               @id @map("user_id")
  user      PortalUser        @relation(fields: [userId], references: [id], onDelete: Cascade)
  tier      PortalPricingTier
  setBy     Int?              @map("set_by")
  createdAt DateTime          @default(now()) @map("created_at")
  updatedAt DateTime          @updatedAt @map("updated_at")

  @@map("portal_customer_pricing")
}

// Each customer's saved cart, stored on the server so it follows the
// customer between sessions and devices.
model PortalCartItem {
  userId    Int           @map("user_id")
  user      PortalUser    @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId Int           @map("product_id")
  product   PortalProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  qty       Int
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")

  @@id([userId, productId])
  @@map("portal_cart_items")
}

// One row per placed order. The company's details are copied onto the order,
// so later edits to a company never change past orders.
model PortalOrder {
  id           Int               @id @default(autoincrement())
  userId       Int               @map("user_id")
  user         PortalUser        @relation(fields: [userId], references: [id])
  companyId    Int?              @map("company_id")
  status       PortalOrderStatus @default(in_progress)
  companyName  String            @map("company_name")
  shipAddress  String            @map("ship_address")
  shipCity     String            @map("ship_city")
  shipState    String            @map("ship_state") @db.VarChar(2)
  shipZip      String            @map("ship_zip") @db.VarChar(10)
  license      String
  contactEmail String            @map("contact_email")
  contactPhone String            @map("contact_phone") @db.VarChar(30)
  subtotal     Decimal           @db.Decimal(10, 2)
  createdAt    DateTime          @default(now()) @map("created_at")
  updatedAt    DateTime          @updatedAt @map("updated_at")

  items PortalOrderItem[]

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@map("portal_orders")
}

// The products on each order, with the price actually charged at the time.
model PortalOrderItem {
  id        Int         @id @default(autoincrement())
  orderId   Int         @map("order_id")
  order     PortalOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId Int?        @map("product_id")
  title     String
  image     String
  unitPrice Decimal     @map("unit_price") @db.Decimal(10, 2)
  qty       Int
  lineTotal Decimal     @map("line_total") @db.Decimal(10, 2)

  @@index([orderId])
  @@map("portal_order_items")
}
