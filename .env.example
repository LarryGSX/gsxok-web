# ─────────────────────────────────────────────────────────────
# GSX — Environment Variables
# Copy this file to .env.local and fill in every value.
# Never commit .env.local to version control.
# ─────────────────────────────────────────────────────────────

# ── Database (Neon — Postgres) ────────────────────────────────
# Create a project at https://neon.tech
# Copy the connection string from the Neon dashboard.
# Use the pooled connection string for production.
DATABASE_URL=""

# ── Authentication (NextAuth / Auth.js) ───────────────────────
# Generate a secret with: openssl rand -base64 32
NEXTAUTH_SECRET=""
# Set to your local dev URL in development, production URL in production.
NEXTAUTH_URL="http://localhost:3000"

# ── Sanity CMS ────────────────────────────────────────────────
# Create a project at https://sanity.io
# Project ID and dataset are visible in your Sanity project settings.
NEXT_PUBLIC_SANITY_PROJECT_ID=""
NEXT_PUBLIC_SANITY_DATASET="production"
# Generate a read token in Sanity → API → Tokens (Viewer role for public reads).
SANITY_API_READ_TOKEN=""
# Generate a write token for webhook revalidation (Editor role).
SANITY_REVALIDATE_SECRET=""

# ── Email (Resend) ────────────────────────────────────────────
# Create an account at https://resend.com
# Verify the gsxok.com sender domain.
# Generate an API key in Resend → API Keys.
# Used by app/api/contact/route.ts (the Contact page form) — this is the
# first real usage of Resend in the codebase, so this key must be a live,
# working one and the sender domain below must actually be verified in
# Resend for delivery to succeed.
RESEND_API_KEY=""
# The verified sender address — must be on a verified domain.
EMAIL_FROM="GSX <sales@gsxok.com>"
# Where order notifications are sent (GSX internal).
ORDER_NOTIFICATION_EMAIL="sales@gsxok.com"
# Where Contact page form submissions are sent (GSX internal). Defaults to
# contact@gsxok.com in code if unset.
CONTACT_NOTIFICATION_EMAIL="contact@gsxok.com"

# ── Customer portal (ordering and administrator approvals) ────
# Optional. The defaults below match the approved HostGator site.
# Placed orders go to ORDER_NOTIFICATION_EMAIL (above), with a confirmation
# to the company the customer chose. Resend sends both, so RESEND_API_KEY
# and a verified sender domain are needed for order emails to be delivered.
ORDER_EMAIL_FROM="GSX Orders <sales@gsxok.com>"
# Password-reset emails stay OFF until this is "true", the same as HostGator.
PORTAL_MAIL_READY="false"
PORTAL_EMAIL_FROM="GSX Portal <contact@gsxok.com>"
# Address used in password-reset links. Leave empty to use the address the
# visitor is on.
PORTAL_SITE_BASE_URL=""
